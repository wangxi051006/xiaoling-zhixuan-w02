      "value": {
        "methods": [
          { "code": "COD", "enabled": true, "label": "货到付款" },
          { "code": "BALANCE", "enabled": false, "label": "余额暂未开放" },
          { "code": "WECHAT", "enabled": false, "label": "待接入" }
        ]
      }
    },
    {
      "name": "empty-orders",
      "schema": "OrderList",
      "value": { "items": [], "next_cursor": null }
    }
  ]
