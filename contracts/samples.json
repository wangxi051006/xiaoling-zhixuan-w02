      "schema": "QuoteInput",
      "value": {
        "lines": [{ "sku_id": "synthetic-sku-001", "qty": 2 }],
        "address_id": "synthetic-address-001",
        "delivery_mode": "SCHEDULED",
        "slot_id": "synthetic-slot-001",
        "payment_method": "COD"
      }
    },
    {
      "name": "asap-quote-input",
      "schema": "QuoteInput",
      "value": {
        "lines": [{ "sku_id": "synthetic-sku-001", "qty": 1 }],
        "address_id": "synthetic-address-001",
        "delivery_mode": "ASAP",
        "payment_method": "COD"
      }
    },
    {
      "name": "order-input-no-client-amount",
      "schema": "OrderInput",
      "value": { "quote_id": "synthetic-quote-001", "note": "合成订单格式样本" }
    },
    {
      "name": "slot-conflict",
      "schema": "ApiError",
      "value": { "code": "SLOT_FULL", "message": "该时段已满", "request_id": "synthetic-request-001" }
    },
    {
      "name": "cod-only-payment-options",
