{
	admin off
	auto_https disable_redirects
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	default_bind {$EDGE_BIND:0.0.0.0}
	# Runtime proxy errors also carry request objects unless filtered globally.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
	servers {
		strict_sni_host on
		max_header_size 32KB
		timeouts {
			read_header 5s
			read_body 10s
			write 15s
			idle 60s
		}
	}
}

# Direct TLS edge only. A gateway topology needs a separate reviewed configuration.
(privacy_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
}

(entry) {
	tls {$TLS_CERT_FILE} {$TLS_KEY_FILE}
	import privacy_log
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
	@image_upload {
		method POST
		path /api/v1/admin/product-images
	}
	@other_requests not {
		method POST
		path /api/v1/admin/product-images
	}
	request_body @image_upload {
		max_size 5MiB
	}
	request_body @other_requests {
		max_size 64KB
	}
	root * {$STATIC_ROOT:/opt/campus/current/static}/{args[1]}
	route {
		# Keep this inside route: Caddy sorts an outer respond after route.
		@outside_vpn {
			expression `"{args[1]}" == "admin"`
			not remote_ip {$ADMIN_VPN_CIDRS:127.0.0.1/32 ::1/128}
		}
		respond @outside_vpn "Forbidden" 403
		# Reject cross-origin API calls before forwarding. No CORS is enabled.
		@cross_origin {
			path /api/v1/*
			header Origin *
			not header Origin https://{args[0]}
		}
		respond @cross_origin "Forbidden origin" 403
		handle /api/v1/* {
			reverse_proxy {$API_UPSTREAM:127.0.0.1:8080} {
				header_up Host {http.request.hostport}
				header_up -Forwarded
				header_up -X-Original-URL
				header_up -X-Rewrite-URL
				header_up -X-Forwarded-Origin
				header_up X-Forwarded-For {http.request.remote.host}
				header_up X-Forwarded-Host {http.request.hostport}
				header_up X-Forwarded-Proto https
				transport http {
					dial_timeout 3s
					response_header_timeout 15s
					read_timeout 15s
					write_timeout 10s
				}
			}
		}
		@index path / /{args[1]}.html
		handle @index {
			rewrite * /{args[1]}.html
			header Cache-Control "no-store"
			file_server
		}
		handle /assets/* {
			# The per-entry artifact contains only its manifest dependency closure.
			file_server
		}
		respond "Not found" 404
	}
}

https://{$USER_HOST} {
	import entry {$USER_HOST} user
}
https://{$RIDER_HOST} {
	import entry {$RIDER_HOST} rider
}
https://{$ADMIN_HOST} {
	import entry {$ADMIN_HOST} admin
}

# No wildcard file serving, HTTPS-to-HTTP redirects or diagnostic proxying.
:{$HTTPS_PORT:443} {
	tls {$TLS_CERT_FILE} {$TLS_KEY_FILE}
	import privacy_log
	respond "Unknown host" 421
}
:{$HTTP_PORT:80} {
	import privacy_log
	respond "HTTPS required" 421
}
