# TEMPLATE ONLY. Replace invalid.example and placeholders in an isolated candidate.
# Split these sections into root-owned 0600 files; never source this whole example.
# API /etc/campus/api.env: keys consumed by bootstrap.LoadConfig (startup only).
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://campus_app:REPLACE_RUNTIME_PASSWORD@pg.private.invalid.example:5432/campus?sslmode=verify-full&sslrootcert=/etc/campus/postgres/ca.crt&connect_timeout=5
USER_ORIGIN=https://user.invalid.example
RIDER_ORIGIN=https://rider.invalid.example
ADMIN_ORIGIN=https://admin.invalid.example
COD_ENABLED=true
BALANCE_ENABLED=false
ORDERS_ENABLED=false
DISPATCH_ENABLED=false
ALLOW_TEST_AUTH=false
WECHAT_ENABLED=false

# Optional staff login and rider provisioning: configure all seven keys together.
# Register both admin and rider origins + /api/v1/auth/staff/callback at the IdP.
# STAFF_OIDC_ISSUER=https://idp.invalid.example
# STAFF_OIDC_AUTH_URL=https://idp.invalid.example/authorize
# STAFF_OIDC_TOKEN_URL=https://idp.invalid.example/token
# STAFF_OIDC_JWKS_URL=https://idp.invalid.example/jwks
# STAFF_OIDC_CLIENT_ID=
# STAFF_OIDC_CLIENT_SECRET=
# STAFF_OIDC_MFA_CONTEXT=

# Keep email disabled until authorized SMTP and ingress have been verified.
EMAIL_SIGNUP_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
# EMAIL_CODE_KEY=
# EMAIL_SMTP_ADDR=smtp.invalid.example:587
# EMAIL_SMTP_FROM=accounts@invalid.example
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_IMPLICIT_TLS=false

# MIGRATION ONLY /etc/campus/migration.env: all API keys above, plus this key.
# Root-owned mode 0600; systemd loads it for a short-lived campus-migrate unit.
# The unit receives the environment; the campus-migrate user need not read this file.
# Migration role owns DDL; runtime role receives only necessary DML/sequence grants.
# Backup/WAL role and restricted audit storage credentials are separate again.
# MIGRATION_DATABASE_URL=postgres://campus_migrator:REPLACE_MIGRATION_PASSWORD@pg.private.invalid.example:5432/campus?sslmode=verify-full&sslrootcert=/etc/campus/postgres/ca.crt&connect_timeout=5

# CADDY ONLY /etc/campus/caddy.env, loaded into the Caddy service environment.
USER_HOST=user.invalid.example
RIDER_HOST=rider.invalid.example
ADMIN_HOST=admin.invalid.example
API_UPSTREAM=127.0.0.1:8080
STATIC_ROOT=/opt/campus/current/static
TLS_CERT_FILE=/etc/campus/tls/entries.crt
TLS_KEY_FILE=/etc/campus/tls/entries.key
# Direct client source CIDRs, obtained after VPN routing (never forwarded headers).
# Default loopback denies public admin access until approved VPN CIDRs are supplied.
ADMIN_VPN_CIDRS="127.0.0.1/32 ::1/128"
HTTP_PORT=80
HTTPS_PORT=443
EDGE_BIND=0.0.0.0

# COMPOSE DEV ONLY: never load these into a staging/production service.
# DEV_PG_PORT=55439
# DEV_PG_PASSWORD_FILE=/absolute/isolated/p07-dev-pg-password
# TEST_DATABASE_URL belongs only to test runners, never to api.env/migration.env.
# The SMS OTP provider is not wired by cmd/api.
